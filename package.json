{
  "name": "aimcore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create aimcore",
    "db:migrate:local": "wrangler d1 execute aimcore --local --file=migrations/0001_init.sql",
    "db:migrate:prod": "wrangler d1 execute aimcore --remote --file=migrations/0001_init.sql",
    "db:studio:local": "wrangler d1 execute aimcore --local --command='SELECT name FROM sqlite_master WHERE type=\"table\"'"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
